---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import PageBanner from "../../components/sections/PageBanner.astro";
import LegalDocument from "../../components/sections/LegalDocument.astro";

import { siteName, flat_logo, navItems } from "../../config/site";
import { privacy as doc } from "../../data/legal";

/**
 * Privacy statement page (/privacy). All copy lives in src/data/legal.ts;
 * this file is composition only.
 */
---

<BaseLayout title={doc.seoTitle} description={doc.seoDescription} siteName={siteName}>
  <Header navItems={navItems} slot="header">
    <a slot="logo" href="/" aria-label={`${siteName} home`}>
      <img src={flat_logo.src} alt={flat_logo.alt} class="site-logo" />
    </a>
  </Header>

  <PageBanner heading={doc.heading} />
  <LegalDocument doc={doc} />

  <Footer navItems={navItems} slot="footer" />
</BaseLayout>

<style>
  .site-logo {
    height: 5rem;
    width: auto;
  }
</style>